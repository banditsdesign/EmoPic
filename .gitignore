xcuserdata/
*.xcscmblueprint
build/
DerivedData/
*.xcarchive

# Build artifacts
*.dmg
# Sparkle's update archive, produced next to the DMG by scripts/release.sh
*.zip

# Local-only planning / review notes (not published)
/docs/

# Local agent tooling (vendored apple-hig skill)
/.dsh/

# Sparkle EdDSA signing material must never be committed. The private key lives
# in the macOS Keychain (see docs/RELEASE_PROCESS.md, local only); these rules
# are a safety net in case a keygen run drops the files in the repo anyway.
eddsa_private_key
eddsa_public_key
*.eddsa_private_key
